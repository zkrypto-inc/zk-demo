# VM(demo.zkrypto.com) 프로덕션 빌드용 — `npm run build`에서 .env.local보다 우선 적용된다.
# VM web-server.cjs 프록시 경로와 반드시 일치해야 한다:
#   /wallet/api → 어댑터(:8080, publicBasePath=/wallet/api)
#   /pol/mgr → manager(:21001, strip) · /pol/gen → generator(:21000, strip)
# (로컬 dev는 .env.local의 /wallet/adapter → :8090 프록시를 쓴다)
VITE_ZKWALLET_ADAPTER_BASE_URL=/wallet/api
VITE_ZKWALLET_ADAPTER_AUTORUN=true
